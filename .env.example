# ============================================================================
# CONFIGURACION DE ENTORNO - FRONTEND - PRUEBA DIGITAL
# ============================================================================
# ******************************************************************************
# *              >>> PLANTILLA PARA DESARROLLO LOCAL <<<                        *
# ******************************************************************************
#
# INSTRUCCIONES:
#   1. Copia este archivo como ".env" en la misma carpeta:
#      cp .env.example .env
#
#   2. Para DESARROLLO LOCAL, deja VITE_API_URL=/api
#      El proxy de Vite (vite.config.js) redirigira las peticiones
#      al backend local (http://localhost:3000)
#
#   3. El archivo .env esta en .gitignore, NO se sube al repositorio
#
# COMO FUNCIONA:
#   [LOCAL]   VITE_API_URL=/api -> Vite proxy -> http://localhost:3000/api
#   [RAILWAY] VITE_API_URL=https://api.digitalevidence360.com/api
#
# ============================================================================

# URL base de la API
# [LOCAL]   Dejar como /api (el proxy de Vite se encarga del resto)
# [RAILWAY] VITE_API_URL=https://api.digitalevidence360.com/api
VITE_API_URL=/api
